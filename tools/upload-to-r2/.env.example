# Cloudflare R2 S3-compatible credentials
# Create an API token at:
#   https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# The token needs the "Object Read & Write" permission scoped to your bucket.

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=audiobooks

# Public read URL — paste this into the app's R2 settings (and only this one).
# Either the auto-generated pub-*.r2.dev URL or your custom domain.
R2_PUBLIC_BASE_URL=https://pub-<HASH>.r2.dev
